   "source": "<img src=\"https://raw.githubusercontent.com/mauriciorslrv/DS_basics/content/statistics-module-rework/02%20An%C3%A1lisis%20Estad%C3%ADstico%20de%20Datos/imgs/Ciclo_MC.png\" alt=\"Ciclo Monte Carlo\" width=\"650\">\n"
